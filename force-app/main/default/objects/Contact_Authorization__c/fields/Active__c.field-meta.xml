<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Active__c</fullName>
    <description>Indicates whether the authorization is currently effective based on its effective and expiration dates.</description>
    <formula>AND(Effective_Date__c &lt;= TODAY(), OR(ISBLANK(Expiration_Date__c), Expiration_Date__c &gt;= TODAY()))</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Active</label>
    <type>Checkbox</type>
</CustomField>
