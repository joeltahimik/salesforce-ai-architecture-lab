<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Represents one specific requested employment change within an Employment Change Request, including requested state, Payroll decision, and authoritative implemented outcome.</description>
    <enableActivities>false</enableActivities>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <label>Employment Change Item</label>
    <nameField>
        <displayFormat>ECI-{000000}</displayFormat>
        <label>Employment Change Item Number</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Employment Change Items</pluralLabel>
    <sharingModel>ControlledByParent</sharingModel>
</CustomObject>
