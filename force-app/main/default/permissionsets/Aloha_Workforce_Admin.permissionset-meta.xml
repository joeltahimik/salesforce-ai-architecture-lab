        <field>Employment__c.Employee_Number__c</field>
        <readable>true</readable>
    </fieldPermissions>

    <fieldPermissions>
        <editable>true</editable>
        <field>Employment__c.Hire_Date__c</field>
        <readable>true</readable>
    </fieldPermissions>

