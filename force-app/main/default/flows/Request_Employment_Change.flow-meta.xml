<?xml version='1.0' encoding='UTF-8'?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Adds the prepared Employment Change Item to the in-memory change package after duplicate validation.</description>
        <name>Add_Working_Change_Item</name>
        <label>Add Working Change Item</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Change_Item_Collection</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Working_Change_Item</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Add_Another_Change</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Count_And_Capture_Employment</name>
        <label>Count and Capture Employment</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Affected_Employment_Count</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Selected_Employment_Id</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_Affected_Employments.Employment__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Affected_Employments</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Normalizes standard employment change inputs into common working variables for downstream item processing.</description>
        <name>Normalize_Standard_Change</name>
        <label>Normalize Standard Change</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Working_Requested_Value</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Requested_Value</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Working_Requested_Effective_Date</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Standard_Requested_Effective_Date</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Prepare_Working_Change_Item</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Normalizes the selected Work Location and effective date into common working variables while preserving the Work Location record Id.</description>
        <name>Normalize_Work_Location_Change</name>
        <label>Normalize Work Location Change</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Working_Requested_Value</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Requested_Work_Location.Name</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Working_Requested_Effective_Date</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Requested_Effective_Date</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Working_Requested_Work_Location_Id</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Requested_Work_Location.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Prepare_Working_Change_Item</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Populates the working Employment Change Item from the normalized change inputs before duplicate checking and collection processing.</description>
        <name>Prepare_Working_Change_Item</name>
        <label>Prepare Working Change Item</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Working_Change_Item.Change_Type__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Change_Type</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Working_Change_Item.Requested_Value__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Working_Requested_Value</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Working_Change_Item.Requested_Effective_Date__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Working_Requested_Effective_Date</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Working_Change_Item.Requested_Work_Location__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Working_Requested_Work_Location_Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Working_Change_Item.Item_Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Submitted</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Change_Item_Collection_Empty</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Clears working change resources before the user begins another employment change item.</description>
        <name>Reset_Change_Inputs</name>
        <label>Reset Change Inputs</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Working_Change_Item.Change_Type__c</assignToReference>
            <operator>Assign</operator>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Working_Change_Item.Requested_Value__c</assignToReference>
            <operator>Assign</operator>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Working_Change_Item.Requested_Effective_Date__c</assignToReference>
            <operator>Assign</operator>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Working_Change_Item.Requested_Work_Location__c</assignToReference>
            <operator>Assign</operator>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Working_Requested_Value</assignToReference>
            <operator>Assign</operator>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Working_Requested_Effective_Date</assignToReference>
            <operator>Assign</operator>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Working_Requested_Work_Location_Id</assignToReference>
            <operator>Assign</operator>
        </assignmentItems>
        <connector>
            <isGoTo>true</isGoTo>
            <targetReference>Employment_Change_Details</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Associates the current employment change item with the newly created Employment Change Request and adds it to the final submission collection.</description>
        <name>Prepare_Submission_Change_Item</name>
        <label>Prepare Submission Change Item</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Loop_Submission_Change_Items.Employment_Change_Request__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Create_Employment_Change_Request.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Final_Change_Item_Collection</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Submission_Change_Items</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Submission_Change_Items</targetReference>
        </connector>
    </assignments>
    <choices>
        <name>Add_Another_Change_Choice</name>
        <choiceText>Add Another Change</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Add Another Change</stringValue>
        </value>
    </choices>
    <choices>
        <name>Review_Changes_Choice</name>
        <choiceText>Review Changes</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Review Changes</stringValue>
        </value>
    </choices>
    <decisions>
        <name>Affected_Employments_Found</name>
        <label>Affected Employments Found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>No_Affected_Employments</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Affected Employments</defaultConnectorLabel>
        <rules>
            <name>Affected_Employments_Exist</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Affected_Employments</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Affected_Employments</targetReference>
            </connector>
            <label>Affected Employments Exist</label>
        </rules>
    </decisions>
    <decisions>
        <description>Determines whether the in-memory employment change item collection already contains items before duplicate checking.</description>
        <name>Change_Item_Collection_Empty</name>
        <label>Change Item Collection Empty?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_Existing_Change_Items</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Has Existing Items</defaultConnectorLabel>
        <rules>
            <name>Collection_Is_Empty</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Change_Item_Collection</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Add_Working_Change_Item</targetReference>
            </connector>
            <label>Collection Is Empty</label>
        </rules>
    </decisions>
    <decisions>
        <description>Routes Work Location changes to the structured Work Location path. All other employment change types follow the standard change path.</description>
        <name>Determine_Change_Type</name>
        <label>Determine Change Type</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Standard_Change_Details</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Standard Change</defaultConnectorLabel>
        <rules>
            <name>Work_Location_Selected</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Change_Type</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Work Location</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Work_Location_Change_Details</targetReference>
            </connector>
            <label>Work Location</label>
        </rules>
    </decisions>
    <decisions>
        <name>Determine_Employment_Count</name>
        <label>Determine Employment Count</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Multiple_Affected_Employments</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Multiple Employments</defaultConnectorLabel>
        <rules>
            <name>Exactly_One_Employment</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Affected_Employment_Count</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Selected_Employment</targetReference>
            </connector>
            <label>Exactly One Employment</label>
        </rules>
    </decisions>
    <decisions>
        <description>Routes the user either back to enter another employment change or forward to review the package.</description>
        <name>Determine_Next_Change_Action</name>
        <label>Determine Next Change Action</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Review_Changes_Placeholder</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Review Changes</defaultConnectorLabel>
        <rules>
            <name>Add_Another_Change_Selected</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Next_Change_Action</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Add Another Change</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Reset_Change_Inputs</targetReference>
            </connector>
            <label>Add Another Change</label>
        </rules>
    </decisions>
    <decisions>
        <description>Prevents more than one employment change item with the same Change Type from being added to a single employment change request package.</description>
        <name>Duplicate_Change_Type</name>
        <label>Duplicate Change Type?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_Existing_Change_Items</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Different Change Type</defaultConnectorLabel>
        <rules>
            <name>Duplicate_Type_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Existing_Change_Items.Change_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Change_Type</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Duplicate_Change_Type_Message</targetReference>
            </connector>
            <label>Duplicate Type Found</label>
        </rules>
    </decisions>
    <description>Guides users through requesting one or more employment changes from a Service Request. The flow identifies affected employment records, captures requested changes, and creates the employment change request and items.</description>
    <dynamicChoiceSets>
        <name>Available_Work_Locations</name>
        <dataType>String</dataType>
        <displayField>Name</displayField>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Employer__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Selected_Employment.Employer__c</elementReference>
            </value>
        </filters>
        <object>Work_Location__c</object>
        <valueField>Id</valueField>
    </dynamicChoiceSets>
    <dynamicChoiceSets>
        <name>Change_Type_Choices</name>
        <dataType>Picklist</dataType>
        <displayField xsi:nil="true" />
        <object xsi:nil="true" />
        <picklistField>Change_Type__c</picklistField>
        <picklistObject>Employment_Change_Item__c</picklistObject>
    </dynamicChoiceSets>
    <environments>Default</environments>
    <interviewLabel>Request Employment Change {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Request Employment Change</label>
    <loops>
        <description>Counts affected Employments and captures the Employment Id when only one Employment is associated with the Service Request.</description>
        <name>Loop_Affected_Employments</name>
        <label>Loop Affected Employments</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Affected_Employments</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Count_And_Capture_Employment</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Determine_Employment_Count</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <description>Checks existing in-memory employment change items for a duplicate Change Type.</description>
        <name>Loop_Existing_Change_Items</name>
        <label>Loop Existing Change Items</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Change_Item_Collection</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Duplicate_Change_Type</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Add_Working_Change_Item</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <description>Loops through the reviewed employment change items after the parent Employment Change Request has been created.</description>
        <name>Loop_Submission_Change_Items</name>
        <label>Loop Submission Change Items</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Change_Item_Collection</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Prepare_Submission_Change_Item</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Create_Employment_Change_Items</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordCreates>
        <name>Create_Employment_Change_Request</name>
        <label>Create Employment Change Request</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Case__c</field>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Employment__c</field>
            <value>
                <elementReference>Selected_Employment_Id</elementReference>
            </value>
        </inputAssignments>
        <object>Employment_Change_Request__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
        <connector>
            <targetReference>Loop_Submission_Change_Items</targetReference>
        </connector>
    </recordCreates>
    <recordCreates>
        <description>Creates all submitted Employment Change Items in one bulk operation after each item has been associated with the newly created Employment Change Request.</description>
        <name>Create_Employment_Change_Items</name>
        <label>Create Employment Change Items</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputReference>Final_Change_Item_Collection</inputReference>
        <connector>
            <targetReference>Employment_Change_Request_Submitted</targetReference>
        </connector>
    </recordCreates>
    <recordLookups>
        <description>Retrieves Case Employment junction records associated with the current Service Request to identify affected Employments.</description>
        <name>Get_Affected_Employments</name>
        <label>Get Affected Employments</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Affected_Employments_Found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Case__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Case_Employment__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Retrieves the selected Work Location so its Id and Name can be preserved on the employment change item.</description>
        <name>Get_Requested_Work_Location</name>
        <label>Get Requested Work Location</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Normalize_Work_Location_Change</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Requested_Work_Location</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Work_Location__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Retrieves the Contact associated with the selected Employment for display and downstream processing.</description>
        <name>Get_Selected_Employee</name>
        <label>Get Selected Employee</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Selected_Employer</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Selected_Employment.Employee__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Contact</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Retrieves the Account associated with the selected Employment for display and downstream processing.</description>
        <name>Get_Selected_Employer</name>
        <label>Get Selected Employer</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Employment_Change_Details</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Selected_Employment.Employer__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Account</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Retrieves the Employment selected or automatically identified for the employment change request.</description>
        <name>Get_Selected_Employment</name>
        <label>Get Selected Employment</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Selected_Employee</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Selected_Employment_Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Employment__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <screens>
        <name>Add_Another_Change</name>
        <label>Add Another Change?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Determine_Next_Change_Action</targetReference>
        </connector>
        <fields>
            <name>Change_Added_Message</name>
            <fieldText>&lt;p&gt;&lt;strong&gt;Change added to the request.&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;You can add another employment change or continue to review the changes already entered.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>Next_Change_Action</name>
            <choiceReferences>Add_Another_Change_Choice</choiceReferences>
            <choiceReferences>Review_Changes_Choice</choiceReferences>
            <dataType>String</dataType>
            <fieldText>What would you like to do?</fieldText>
            <fieldType>RadioButtons</fieldType>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Duplicate_Change_Type_Message</name>
        <label>Duplicate Change Type</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Duplicate_Change_Type_Instructions</name>
            <fieldText>&lt;p&gt;&lt;strong&gt;This change type has already been added.&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;Each change type can only be included once in an employment change request. Return and choose a different change type.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Employment_Change_Details</name>
        <label>Employment Change Details</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
