<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Can_Record_Implementation</name>
        <label>Can Record Implementation?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Refresh_Ineligible_Item</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Cannot Record</defaultConnectorLabel>
        <rules>
            <name>Eligible</name>
            <conditionLogic>1 AND (2 OR 3)</conditionLogic>
            <conditions>
                <leftValueReference>Get_Employment_Change_Item.Item_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Awaiting Implementation</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Employment_Change_Item.Payroll_Decision__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Employment_Change_Item.Payroll_Decision__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Modified</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Implementation_ECR</targetReference>
            </connector>
            <label>Eligible</label>
        </rules>
    </decisions>
    <decisions>
        <name>Determine_Implementation_Change_Type</name>
        <label>Determine Implementation Change Type</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Record_Actual_Implementation</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Other Change</defaultConnectorLabel>
        <rules>
            <name>Work_Location</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Employment_Change_Item.Change_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Work Location</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Record_Actual_Work_Location</targetReference>
            </connector>
            <label>Work Location</label>
        </rules>
    </decisions>
    <description>Records the actual Payroll implementation of an authorized employment change. Payroll-authorized values are shown for reference while implemented values are captured independently as evidence of what actually occurred.</description>
    <dynamicChoiceSets>
        <name>Available_Implementation_Work_Locations</name>
        <dataType>String</dataType>
        <displayField>Name</displayField>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Employer__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Implementation_Employment.Employer__c</elementReference>
            </value>
        </filters>
        <object>Work_Location__c</object>
        <valueField>Id</valueField>
    </dynamicChoiceSets>
    <environments>Default</environments>
    <interviewLabel>Record Employment Change Implementation {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Record Employment Change Implementation</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordLookups>
        <description>Retrieves the Employment Change Item whose actual implementation is being recorded.</description>
        <name>Get_Employment_Change_Item</name>
        <label>Get Employment Change Item</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Can_Record_Implementation</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Employment_Change_Item__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Retrieves the parent Employment Change Request to identify the Employment associated with the implementation.</description>
        <name>Get_Implementation_ECR</name>
        <label>Get Implementation Employment Change Request</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Implementation_Employment</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Employment_Change_Item.Employment_Change_Request__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Employment_Change_Request__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Retrieves the Employment so Work Location implementation choices can be restricted to the correct employer.</description>
        <name>Get_Implementation_Employment</name>
        <label>Get Implementation Employment</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Determine_Implementation_Change_Type</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Implementation_ECR.Employment__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Employment__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Retrieves the Work Location actually selected as implemented so both its readable name and structured relationship can be recorded.</description>
        <name>Get_Implemented_Work_Location</name>
        <label>Get Implemented Work Location</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Update_Work_Location_Implementation</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Actual_Implemented_Work_Location</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Work_Location__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Refreshes an ineligible Employment Change Item so the current status can be displayed reliably.</description>
        <name>Refresh_Ineligible_Item</name>
