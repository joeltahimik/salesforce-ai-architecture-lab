<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>

    <assignments>
        <name>Set_Awaiting_Payroll_Decision</name>
        <label>Set Awaiting Payroll Decision</label>
        <locationX>50</locationX>
        <locationY>300</locationY>
        <assignmentItems>
            <assignToReference>$Record.Item_Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Awaiting Payroll Decision</stringValue>
            </value>
        </assignmentItems>
    </assignments>

    <assignments>
        <name>Set_Awaiting_Implementation</name>
        <label>Set Awaiting Implementation</label>
        <locationX>250</locationX>
        <locationY>300</locationY>
        <assignmentItems>
            <assignToReference>$Record.Item_Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Awaiting Implementation</stringValue>
            </value>
        </assignmentItems>
    </assignments>

    <assignments>
        <name>Set_Rejected</name>
        <label>Set Rejected</label>
        <locationX>450</locationX>
        <locationY>300</locationY>
        <assignmentItems>
            <assignToReference>$Record.Item_Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Rejected</stringValue>
            </value>
        </assignmentItems>
    </assignments>

    <assignments>
        <name>Set_Implemented</name>
        <label>Set Implemented</label>
        <locationX>650</locationX>
        <locationY>300</locationY>
        <assignmentItems>
            <assignToReference>$Record.Item_Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Implemented</stringValue>
            </value>
        </assignmentItems>
    </assignments>


    <assignments>
        <name>Set_Cancellation_Requested</name>
        <label>Set Cancellation Requested</label>
        <locationX>850</locationX>
        <locationY>300</locationY>
        <assignmentItems>
            <assignToReference>$Record.Item_Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Cancellation Requested</stringValue>
            </value>
        </assignmentItems>
    </assignments>

    <assignments>
        <name>Set_Awaiting_Cancellation_Completion</name>
        <label>Set Awaiting Cancellation Completion</label>
        <locationX>1050</locationX>
        <locationY>300</locationY>
        <assignmentItems>
            <assignToReference>$Record.Item_Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Awaiting Cancellation Completion</stringValue>
            </value>
        </assignmentItems>
    </assignments>

    <assignments>
        <name>Set_Cancelled</name>
        <label>Set Cancelled</label>
        <locationX>1250</locationX>
        <locationY>300</locationY>
        <assignmentItems>
            <assignToReference>$Record.Item_Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Cancelled</stringValue>
            </value>
        </assignmentItems>
    </assignments>

    <decisions>
        <name>Evaluate_Status_Transition</name>
        <label>Evaluate Status Transition</label>
        <locationX>350</locationX>
        <locationY>150</locationY>
        <defaultConnectorLabel>No Status Change</defaultConnectorLabel>

        <rules>
            <name>Cancellation_Completed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Cancellation_Completed_Date__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Cancelled</targetReference>
            </connector>
            <label>Cancellation Completed</label>
        </rules>

        <rules>
            <name>Payroll_Cancellation_Acknowledged</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Payroll_Cancellation_Acknowledged_Date__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Awaiting_Cancellation_Completion</targetReference>
            </connector>
            <label>Payroll Cancellation Acknowledged</label>
        </rules>

        <rules>
            <name>Cancellation_Requested</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Cancellation_Requested_Date__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Cancellation_Requested</targetReference>
            </connector>
            <label>Cancellation Requested</label>
        </rules>

        <rules>
            <name>Payroll_Implementation_Confirmed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Item_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Awaiting Implementation</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Implemented_Value__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Implemented_Effective_Date__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Implemented</targetReference>
            </connector>
            <label>Payroll Implementation Confirmed</label>
        </rules>

        <rules>
            <name>Payroll_Rejected</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Item_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Awaiting Payroll Decision</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Payroll_Decision__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Rejected</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Rejected</targetReference>
            </connector>
            <label>Payroll Rejected</label>
        </rules>

        <rules>
            <name>Payroll_Approved_Or_Modified</name>
            <conditionLogic>1 AND (2 OR 3)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Item_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Awaiting Payroll Decision</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Payroll_Decision__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Payroll_Decision__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Modified</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Awaiting_Implementation</targetReference>
            </connector>
            <label>Payroll Approved or Modified</label>
        </rules>

        <rules>
            <name>Payroll_Acknowledged</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Item_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Submitted</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Payroll_Transaction_ID__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Awaiting_Payroll_Decision</targetReference>
            </connector>
            <label>Payroll Acknowledged</label>
        </rules>
    </decisions>

    <description>
        Derives Employment Change Item lifecycle status from authoritative Payroll facts.
    </description>
    <environments>Default</environments>
    <interviewLabel>Employment Change Item Lifecycle {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Employment Change Item Lifecycle</label>
    <processType>AutoLaunchedFlow</processType>

    <start>
        <locationX>350</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Evaluate_Status_Transition</targetReference>
        </connector>
        <object>Employment_Change_Item__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>

    <status>Active</status>
</Flow>
