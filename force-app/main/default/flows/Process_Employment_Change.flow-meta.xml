    <decisions>
        <name>Can_Process_Item</name>
        <label>Can Process Item?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Refresh_Ineligible_Employment_Change_Item</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Cannot Process</defaultConnectorLabel>
        <rules>
            <name>Eligible</name>
            <conditionLogic>(1 OR 2) AND 3</conditionLogic>
            <conditions>
                <leftValueReference>Get_Employment_Change_Item.Item_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Submitted</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Employment_Change_Item.Item_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Awaiting Payroll Decision</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Employment_Change_Item.Payroll_Decision__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Needs_Payroll_Acknowledgment</targetReference>
            </connector>
            <label>Eligible</label>
        </rules>
