    <description>Allows a user to request cancellation or reversal of an employment change from a Service Request. The flow captures business cancellation facts and relies on the Employment Change Item Lifecycle flow to derive status.</description>
    <environments>Default</environments>
    <interviewLabel>Request Employment Change Cancellation {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Request Employment Change Cancellation</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordLookups>
        <name>Get_Eligible_Employment_Change_Items</name>
        <label>Get Eligible Employment Change Items</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Eligible_Employment_Change_Items_Found</targetReference>
        </connector>
        <filterLogic>1 AND 2 AND 3 AND 4 AND 5</filterLogic>
        <filters>
            <field>Employment_Change_Request__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Employment_Change_Requests.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Item_Status__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Cancelled</stringValue>
            </value>
        </filters>
        <filters>
            <field>Item_Status__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Cancellation Requested</stringValue>
            </value>
        </filters>
        <filters>
            <field>Item_Status__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Awaiting Cancellation Completion</stringValue>
            </value>
        </filters>
        <filters>
            <field>Item_Status__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Rejected</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Employment_Change_Item__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Employment_Change_Requests</name>
        <label>Get Employment Change Requests</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Employment_Change_Request_Found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Case__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Employment_Change_Request__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <description>Records the business cancellation request on the selected employment change item. Lifecycle status is derived separately by automation.</description>
        <name>Update_Cancellation_Request</name>
