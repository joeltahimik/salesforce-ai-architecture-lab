system:
    instructions: |
        This temporary pilot only checks whether an Apex diagnostic completed.
        Use only the result from the current turn. Never ask for or disclose user IDs,
        credentials, or employment data. Do not act on other requests.
    messages:
        welcome: "Send Run identity probe to start the diagnostic."
        error: "The diagnostic is unavailable."

config:
    developer_name: "Aloha_Workforce_Identity_Pilot"
    agent_type: "AgentforceEmployeeAgent"
    agent_label: "Aloha Workforce Identity Pilot"
    description: "Temporary diagnostic for authenticated Lightning execution."

language:
    default_locale: "en_US"
    all_additional_locales: False

variables:
    probe_completed: mutable boolean = False

start_agent identity_probe:
    label: "Identity Probe"
    description: "Runs the identity diagnostic on each pilot turn."
    actions:
        run_identity_probe:
            label: "Run Identity Probe"
            description: "Runs the diagnostic and returns a completion flag."
            target: "apex://AlohaAgentIdentityProbe"
            inputs:
                requested: boolean
                    description: "Fixed request flag set by the pilot."
                    is_required: True
            outputs:
                completed: boolean
                    description: "Whether the diagnostic ran."
    reasoning:
        instructions: ->
            set @variables.probe_completed = False
            run @actions.run_identity_probe
                with requested = True
                set @variables.probe_completed = @outputs.completed
            if @variables.probe_completed == True:
                | Reply only: The diagnostic completed.
            else:
                | Reply only: The diagnostic is unavailable.
